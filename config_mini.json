{
  "project": {
    "name": "rgb_dynamic_attention_localization",
    "seed": 42,
    "device": "cuda"
  },
  "colab": {
    "enabled": false,
    "drive_zip_path": "/content/drive/MyDrive/REGRESSION_MODEL/data.zip",
    "local_dataset_dir": "/content/dataset",
    "drive_checkpoint_dir": "/content/drive/MyDrive/REGRESSION_MODEL/checkpoints"
  },
  "data": {
    "room_csv": "data/raw/room/pose.csv",
    "corridor_csv": "data/raw/corridor/pose.csv",
    "total_csv": "data/processed/total_poses_mini.csv",
    "processed_root": "data/processed",
    "attention_maps_dir": "data/processed/attention_maps",
    "image_size": [
      224,
      224
    ],
    "batch_size": 8,
    "num_workers": 0,
    "pin_memory": true,
    "train_ratio": 0.7,
    "val_ratio": 0.2,
    "test_ratio": 0.1
  },
  "coordinate_alignment": {
    "corridor": {
      "delta_x": 0.0,
      "delta_y": 0.0
    }
  },
  "global_normalization": {
    "x_min": -1.143259525,
    "x_max": 0.30597198,
    "y_min": -0.002151571,
    "y_max": 2.099891186
  },
  "labels": {
    "room": 0,
    "corridor": 1
  },
  "image_normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "model": {
    "num_classes_topo": 2,
    "pretrained": true,
    "dropout_p": 0.3
  },
  "training": {
    "epochs": 10,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "checkpoint_interval": 10
  },
  "loss": {
    "gamma": 0.5
  },
  "checkpoint": {
    "local_dir": "checkpoints",
    "save_best": true,
    "monitor": "val_total_loss"
  },
  "attention": {
    "alpha": 0.7,
    "map_mode": "grayscale",
    "apply_level": "feature"
  }
}