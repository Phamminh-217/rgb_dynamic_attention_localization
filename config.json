{
  "project": {
    "name": "rgb_dynamic_attention_localization",
    "seed": 42,
    "device": "cuda"
  },
  "camera": {
    "fx": 554.0,
    "fy": 554.0,
    "cx": 320.0,
    "cy": 240.0,
    "width": 640,
    "height": 480
  },
  "colab": {
    "enabled": false,
    "drive_zip_path": "/content/drive/MyDrive/REGRESSION_MODEL/data.zip",
    "local_dataset_dir": "/content/dataset",
    "drive_checkpoint_dir": "/content/drive/MyDrive/REGRESSION_MODEL/checkpoints"
  },
  "data": {
    "raw_root": "data/raw",
    "total_csv": "data/processed/total_poses.csv",
    "processed_root": "data/processed",
    "attention_maps_dir": "data/processed/attention_maps",
    "image_size": [
      240,
      320
    ],
    "batch_size": 64,
    "num_workers": 2,
    "pin_memory": true,
    "train_ratio": 0.7,
    "val_ratio": 0.2,
    "test_ratio": 0.1
  },
  "areas": {
    "A": {
      "label": 0,
      "description": "room",
      "runs": [
        {
          "dir_name": "room_lan1",
          "encoder_lan": 1
        },
        {
          "dir_name": "room_lan2",
          "encoder_lan": 2
        },
        {
          "dir_name": "room_lan3",
          "encoder_lan": 3
        }
      ]
    },
    "B": {
      "label": 1,
      "description": "corridor_B",
      "runs": [
        {
          "dir_name": "coridor_lan1_fix",
          "encoder_lan": 4
        },
        {
          "dir_name": "coridor_lan2",
          "encoder_lan": 5
        }
      ]
    },
    "C": {
      "label": 2,
      "description": "intersection",
      "runs": [
        {
          "dir_name": "lan1_giaonhau",
          "encoder_lan": 6
        },
        {
          "dir_name": "lan2_giaonhau",
          "encoder_lan": 7
        }
      ]
    },
    "D": {
      "label": 3,
      "description": "corridor_D",
      "runs": [
        {
          "dir_name": "coridor_lan1_D",
          "encoder_lan": 8
        },
        {
          "dir_name": "coridor_lan2_D",
          "encoder_lan": 9
        }
      ]
    },
    "E": {
      "label": 4,
      "description": "elevator",
      "runs": [
        {
          "dir_name": "thangmay_lan1",
          "encoder_lan": 10
        },
        {
          "dir_name": "thangmay_lan2",
          "encoder_lan": 11
        }
      ]
    }
  },
  "global_normalization": {
    "x_min": -0.1715684633363646,
    "x_max": 28.64391867477021,
    "y_min": -2.12,
    "y_max": 40.097599736094615
  },
  "labels": {
    "A": 0,
    "B": 1,
    "C": 2,
    "D": 3,
    "E": 4
  },
  "image_normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "model": {
    "num_classes_topo": 5,
    "pretrained": true,
    "dropout_p": 0.3
  },
  "training": {
    "epochs": 100,
    "learning_rate": 0.002,
    "weight_decay": 0.0001,
    "checkpoint_interval": 10,
    "early_stopping_patience": 15
  },
  "loss": {
    "gamma": 0.5
  },
  "checkpoint": {
    "local_dir": "checkpoints",
    "save_best": true,
    "monitor": "val_total_loss"
  },
  "attention": {
    "alpha": 0.7,
    "map_mode": "grayscale",
    "apply_level": "feature"
  }
}